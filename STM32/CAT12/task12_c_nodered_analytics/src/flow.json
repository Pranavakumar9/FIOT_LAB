  {
    "id": "fn_calc_stats",
    "type": "function",
    "z": "tab_bme280_analytics",
    "name": "Compute Min / Max / Avg Stats",
    "func": "// Retrieve or initialize historical statistical accumulator in context memory\nlet stats = context.get('stats') || {\n    count: 0,\n    temp: { min: Infinity, max: -Infinity, sum: 0 },\n    hum:  { min: Infinity, max: -Infinity, sum: 0 },\n    press:{ min: Infinity, max: -Infinity, sum: 0 }\n};\n\nlet data = msg.payload;\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch(e) {\n        node.error(\"Invalid JSON\", msg);\n        return null;\n    }\n}\n\nlet t = parseFloat(data.temperature);\nlet h = parseFloat(data.humidity);\nlet p = parseFloat(data.pressure);\n\nif (!isNaN(t) && !isNaN(h) && !isNaN(p)) {\n    stats.count++;\n    \n    // Temperature\n    if (t < stats.temp.min) stats.temp.min = t;\n    if (t > stats.temp.max) stats.temp.max = t;\n    stats.temp.sum += t;\n    \n    // Humidity\n    if (h < stats.hum.min) stats.hum.min = h;\n    if (h > stats.hum.max) stats.hum.max = h;\n    stats.hum.sum += h;\n    \n    // Pressure\n    if (p < stats.press.min) stats.press.min = p;\n    if (p > stats.press.max) stats.press.max = p;\n    stats.press.sum += p;\n    \n    context.set('stats', stats);\n    \n    let avgT = (stats.temp.sum / stats.count).toFixed(2);\n    let avgH = (stats.hum.sum / stats.count).toFixed(2);\n    let avgP = (stats.press.sum / stats.count).toFixed(2);\n    \n    msg.statistics = {\n        samples: stats.count,\n        temperature: { min: stats.temp.min.toFixed(2), max: stats.temp.max.toFixed(2), avg: avgT },\n        humidity:    { min: stats.hum.min.toFixed(2),  max: stats.hum.max.toFixed(2),  avg: avgH },\n        pressure:    { min: stats.press.min.toFixed(2), max: stats.press.max.toFixed(2), avg: avgP }\n    };\n    \n    msg.payload = \n        \"====================================================\\n\" +\n        \" Parameter        Minimum    Maximum    Average     \\n\" +\n        \"====================================================\\n\" +\n        ` Temperature (C)  ${stats.temp.min.toFixed(2).padEnd(10)} ${stats.temp.max.toFixed(2).padEnd(10)} ${avgT}\\n` +\n        ` Humidity (%RH)   ${stats.hum.min.toFixed(2).padEnd(10)} ${stats.hum.max.toFixed(2).padEnd(10)} ${avgH}\\n` +\n        ` Pressure (hPa)   ${stats.press.min.toFixed(2).padEnd(10)} ${stats.press.max.toFixed(2).padEnd(10)} ${avgP}\\n` +\n        \"==================================================== (Samples: \" + stats.count + \")\";\n        \n    return msg;\n}\n\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 770,
    "y": 140,
    "wires": [
      [
        "debug_stats_table"
      ]
    ]
  },
